import urllib.request
import csv
import json

def fetch_and_filter_airports():
    print("Downloading global airport data from OurAirports...")
    url = "https://davidmegginson.github.io/ourairports-data/airports.csv"
    raw_csv_path = "raw_airports.csv"
    
    try:
        urllib.request.urlretrieve(url, raw_csv_path)
    except Exception as e:
        print(f"Error downloading data: {e}")
        return

    game_airports = {}
    print("Processing and filtering dataset...")

    with open(raw_csv_path, mode="r", encoding="utf-8") as f:
        reader = csv.DictReader(f)
        for row in reader:
            # Filter for commercial medium/large airports with valid IATA codes
            if row["type"] in ["medium_airport", "large_airport"] and row["iata_code"]:
                iata = row["iata_code"].strip().upper()
                game_airports[iata] = {
                    "name": row["name"],
                    "municipality": row["municipality"],
                    "country": row["iso_country"],
                    "lat": float(row["latitude_deg"]),
                    "lon": float(row["longitude_deg"]),
                    "type": row["type"]
                }

    output_json_path = "airports.json"
    with open(output_json_path, "w", encoding="utf-8") as f:
        json.dump(game_airports, f, indent=4)

    print(f"Success! Saved {len(game_airports)} commercial airports into '{output_json_path}'.")

if __name__ == "__main__":
    fetch_and_filter_airports()
